# Copy to `.env.local` and adjust. All values are development-only shims.

# Tenant sent as `X-Tenant-Id` on every API request. Any non-empty string works — but read
# and write with the SAME value, because tenant scoping is an EF global query filter.
# Replaced by the spec-15 signed `X-Tenant-Context` once the web-origin auth flow lands.
VITE_DEV_TENANT_ID=demo

# Operator identity for staff writes that the API audits (`X-Actor` / `X-Actor-Role`):
# waitlist actions, menu owner actions, preorder, DLQ replay, operation resume/resolve.
VITE_DEV_ACTOR=console-operator
VITE_DEV_ACTOR_ROLE=operator

# Where `bun nx serve web` proxies `/api`. Use the http port if you have not trusted the
# dev TLS certificate: http://localhost:8000
VITE_API_PROXY_TARGET=https://localhost:8001
