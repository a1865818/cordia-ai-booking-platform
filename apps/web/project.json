{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "tags": [
    "scope:web",
    "type:app",
    "lang:typescript"
  ],
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/web",
        "command": "bun install"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/web",
        "command": "bunx vite"
      }
    },
    "serve-log": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/web",
        "command": "node ../../tools/scripts/serve-log.mjs web bunx vite"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "inputs": [
        "typescript",
        {
          "env": "VITE_BASE_PATH"
        }
      ],
      "cache": true,
      "options": {
        "cwd": "apps/web",
        "command": "bunx tsc -b && bunx vite build"
      },
      "outputs": [
        "{workspaceRoot}/dist/apps/web"
      ]
    },
    "preview": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "apps/web",
        "command": "bunx vite preview"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "inputs": [
        "typescript"
      ],
      "cache": true,
      "metadata": {
        "description": "Bun's native test runner, not vitest. `--parallel` (isolated global per worker process) is required — Bun's bare default shares one module registry across every test file in the run, so one file's `mock.module()` silently leaks into another's. See src/test/vi.ts for why partial module mocks (vitest's `importOriginal` idiom) are written the way they are; that workaround is for an unrelated, still-open Bun 1.4 `mock.module`+`import()` deadlock, not for this."
      },
      "options": {
        "cwd": "apps/web",
        "command": "bun test --parallel"
      }
    },
    "test-coverage": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "inputs": [
        "typescript"
      ],
      "cache": true,
      "options": {
        "cwd": "apps/web",
        "command": "bunx vitest run --coverage"
      },
      "outputs": [
        "{projectRoot}/coverage"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/src/**/*.{ts,tsx,js,jsx}",
        "{projectRoot}/.oxlintrc.json"
      ],
      "cache": true,
      "options": {
        "cwd": "apps/web",
        "command": "bunx oxlint src/ --deny-warnings"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "inputs": [
        "typescript"
      ],
      "cache": true,
      "metadata": {
        "description": "tsc -b, NOT plain tsc: apps/web/tsconfig.json is solution-style ({ files: [], references: [...] }), so `tsc --noEmit` compiled zero files and exited 0 on any type error. Errors only surfaced at build time."
      },
      "options": {
        "cwd": "apps/web",
        "command": "bunx tsc -b --noEmit"
      }
    }
  }
}
