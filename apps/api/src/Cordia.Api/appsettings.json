{
  "Cordia": {
    "ReleaseCode": "0.0.1",
    "EnvironmentCode": "dev"
  },
  "ConnectionStrings": {
    "CordiaDBConnection": "Host=localhost;Port=5432;Database=Cordia_API;Username=cordia;Password=localdev"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "LangGraph": {
    "Host": "https://localhost:2024"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "DatabaseBootstrap": {
    "MigrateOnStartup": false
  },
  "OperatorSession": {
    "TtlSeconds": 28800
  }
}
