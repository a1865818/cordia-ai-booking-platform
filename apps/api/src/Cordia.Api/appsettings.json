{
  "Cordia": {
    "ReleaseCode": "0.0.1",
    "EnvironmentCode": "dev"
  },
  "ConnectionStrings": {
    "CordiaDBConnection": "Host=localhost;Port=5432;Database=Cordia_API;Username=cordia;Password=localdev"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "LangGraph": {
    "_comment": "Host is http, not https: `langgraph dev` serves plain HTTP on :2024. The committed default said https while nothing read it; it is authoritative now. ExtractTimeoutSeconds is also a transaction-hold budget — the call runs inside the ingestion inbox transaction.",
    "Host": "http://localhost:2024",
    "ExtractPath": "/internal/menu/extract",
    "ExtractTimeoutSeconds": 120
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "DatabaseBootstrap": {
    "MigrateOnStartup": false
  },
  "OperatorSession": {
    "TtlSeconds": 28800
  }
}
