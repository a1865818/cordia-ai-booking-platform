# === LangSmith (optional tracing) ===
# LANGSMITH_PROJECT=cordia
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=...
# LANGSMITH_TRACING=true

# === Azure AI Foundry (model layer) ===
#
# Endpoint form depends on AZURE_OPENAI_MODEL_PROVIDER:
#   azure_openai (default) — the resource endpoint from the Azure OpenAI
#     resource's "Keys and Endpoint" blade:
#       https://<resource-name>.openai.azure.com/
#     NOT the regional Cognitive Services URL
#     (https://<region>.api.cognitive.microsoft.com) — that one 404s on the
#     deployments path.
#   azure_ai — the Foundry project endpoint:
#       https://<resource-name>.services.ai.azure.com
#     "/openai/v1" is appended automatically; an endpoint that already carries a
#     version segment (/openai/v1, /models, /v1) is used verbatim, so a custom
#     gateway or model router can be configured here directly.
#
# AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
# AZURE_OPENAI_API_KEY=...
#
# The DEPLOYMENT name you created in Foundry — often different from the
# underlying model name.
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
#
# Which client surface to build. Use azure_openai for OpenAI-family
# deployments (gpt-4.1, gpt-4o, o-series); azure_ai for everything else in the
# Foundry catalog (Llama, Mistral, Phi, Cohere, DeepSeek).
# AZURE_OPENAI_MODEL_PROVIDER=azure_openai
#
# Default is new enough for both API surfaces.
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
#
# chat_completions (default) or responses. The Responses API is azure_openai
# only and requires AZURE_OPENAI_API_VERSION >= 2025-03-01-preview.
# AZURE_OPENAI_API_SURFACE=chat_completions
#
# Reasoning budget for reasoning deployments; unset leaves the provider default.
# AZURE_OPENAI_REASONING_EFFORT=medium
#
# First-attempt model deadline in seconds. Retries grow the budget; see
# cordia_agent/llm/invoke.py. Read by the CALLER that invokes the model, not by
# the client factory.
#
# WARNING: menu extraction HONOURS this shared value — it is a batch document
# job needing tens of seconds, so a conversational budget set here breaks it
# (every attempt times out, two billed generations discarded, ExtractFailed —
# extraction makes 2 attempts in total, not 2 on top of the first).
# In a process that runs both, leave this unset (or conversational) and use the
# per-role CORDIA_LLM_BASE_TIMEOUT_SECONDS_MENU_EXTRACTOR below, which wins over
# it, to size extraction on its own.
# CORDIA_LLM_BASE_TIMEOUT_SECONDS=8.0
#
# EVERY AZURE_OPENAI_* variable above may be overridden per role by suffixing it
# with _<ROLE>, upper-cased — endpoint, key, api-version, provider, surface and
# reasoning effort included, not just the deployment. That is how one process
# drives a cheap extraction deployment alongside a stronger conversational one.
# Unset ⇒ the shared value is used.
#
# role slot_extractor — model-backed booking-slot capture
# (cordia_agent/slots/extractor.py). Setting the deployment is ALSO what opts a
# process in to the model-backed extractor at graph startup.
# AZURE_OPENAI_DEPLOYMENT_SLOT_EXTRACTOR=gpt-4o-mini
#
# role menu_extractor — the isolated menu-extraction agent's model
# (cordia_agent/menu/model_azure.py). Unset ⇒ the shared AZURE_OPENAI_DEPLOYMENT
# is used; extraction fails closed if neither is set.
# AZURE_OPENAI_DEPLOYMENT_MENU_EXTRACTOR=gpt-4.1-mini

# === Menu extraction (isolated extraction agent) ===
#
# Menu extraction is a BATCH document job, not a conversational turn, so its
# built-in default is NOT the 8 s above: 40 s first attempt, +15 s on the retry,
# 2 attempts in total — 95 s worst case, inside the 105 s ceiling below.
#
# Precedence for the first-attempt budget (seconds):
#   1. CORDIA_LLM_BASE_TIMEOUT_SECONDS_MENU_EXTRACTOR  (this line)
#   2. CORDIA_LLM_BASE_TIMEOUT_SECONDS                 (the shared value above)
#   3. the 40 s built-in default
# Set the per-role form to size extraction independently of the shared value.
# The RESOLVED worst case (base + base+15) must stay within 105 s, so this
# accepts up to 45.0; anything higher is rejected at call time rather than
# silently clamped, because a longer budget only burns a generation the .NET
# caller has already given up on — while holding its Postgres transaction open.
#
# 105 s and not the caller's own 120 s (LangGraph:ExtractTimeoutSeconds) because
# that budget is WIDER in scope: it is armed before the artifact ref is resolved
# and also covers DNS, connect, up to ~1 MiB of request transfer, this route's
# body read and validation, and the response. The 15 s gap is that transport
# headroom — without it the maximum accepted override would consume 100% of the
# caller's budget, so on the worst case the caller is guaranteed to give up
# first: both generations billed, ExtractFailed anyway, 120 s transaction hold.
# CORDIA_LLM_BASE_TIMEOUT_SECONDS_MENU_EXTRACTOR=40.0
#
# ISO-4217 code applied to an item the document priced but never attributed to a
# currency — common, since a menu printing bare "$22.00" carries no locale
# marker. This is CONFIGURATION, not a guess: without it every such row would be
# dropped and a whole menu could extract to an empty draft catalog. Default AUD.
# A code the model DID supply but garbled still drops that row.
#
# SCOPE: this is DEPLOYMENT-level, not per-tenant — one value for the whole
# process. In a multi-tenant deployment a US vendor's bare-"$" menu extracts as
# AUD. A real per-tenant default must come from tenant context and be passed per
# call (AzureExtractionModel already takes default_currency); this env var is the
# single-tenant-deployment stopgap and must not be treated as permanent.
# CORDIA_MENU_EXTRACTION_DEFAULT_CURRENCY=AUD
#
# Shared secret guarding POST /internal/menu/extract — the in-process route the
# .NET API calls to reach the isolated extraction agent
# (cordia_agent/menu/http_app.py, mounted via langgraph.json's http.app).
#
# SET   ⇒ every request must carry a matching X-Cordia-Internal-Key header, or
#          the route answers 401. The comparison is constant-time.
# UNSET ⇒ the route REFUSES TO SERVE — 503 {"error": "auth_not_configured"} on
#          every request — unless CORDIA_MENU_EXTRACTION_ALLOW_ANONYMOUS below
#          is set explicitly.
#
# It used to fail OPEN when unset, and that is exactly the state the deployed
# image shipped in: the key was configured nowhere, LangGraph Platform auth does
# not cover custom routes unless enable_custom_route_auth is on (it is not), and
# the route is published in the deployed /openapi.json and /docs (issue #94).
# "Nobody configured a key" and "this route is public" are different statements.
#
# The .NET side sends the header when Secrets:LangGraphMenuExtractionKey is
# configured, and REFUSES TO START without it outside Development, so the two
# must be set (or unset) together. Never logged on either side.
#
# USE AN ASCII SECRET. HTTP header values are decoded as latin-1 while this
# variable arrives as UTF-8; the two encodings agree exactly on ASCII and
# diverge above it, so a non-ASCII secret would authenticate a latin-1 client
# and reject a UTF-8 one. The .NET side refuses to start on one for the same
# reason. Random ASCII (e.g. `openssl rand -base64 32`) is all a shared secret
# needs to be.
# CORDIA_MENU_EXTRACTION_API_KEY=
#
# Explicit opt-out from that check, for the LOCAL LOOP ONLY.
#
# Set it to any non-empty value (`1`) and the route serves unauthenticated when
# no API key is configured — because `langgraph dev` binds an unauthenticated
# port on localhost anyway and a shared secret between a process and itself buys
# nothing.
#
# `bun nx serve langgraph` and `bun run dev:log` ALREADY SET IT for you (the
# `serve` / `serve-log` targets in apps/langgraph/project.json), so the local
# loop needs nothing here. Uncomment it only if you drive `langgraph dev` by
# hand.
#
# IGNORED when CORDIA_MENU_EXTRACTION_API_KEY is set: a configured key is always
# enforced, so a stale opt-out left in a deployment's environment cannot
# silently disarm it. Never set this anywhere the port is reachable beyond the
# loopback interface.
# CORDIA_MENU_EXTRACTION_ALLOW_ANONYMOUS=1

# === Azure audio (voice pipeline: STT + TTS) ===
#
# Reuses AZURE_OPENAI_ENDPOINT and AZURE_OPENAI_API_KEY above — both audio
# deployments live on the same AI Services resource as the chat deployment.
# Everything below is optional; the defaults match what is deployed.
#
# api-version for both the audio/transcriptions and audio/speech routes.
# CORDIA_AUDIO_API_VERSION=2025-03-01-preview
#
# Deployment names created in Foundry.
# CORDIA_AUDIO_STT_DEPLOYMENT=whisper
# CORDIA_AUDIO_TTS_DEPLOYMENT=gpt-4o-mini-tts
#
# --- Realtime STT (AzureRealtimeSTTProvider, the default) ---
#
# The realtime WebSocket surface streams audio in, streams recognition events
# back, and does its own endpointing — so none of the CORDIA_AUDIO_VAD_* knobs
# below apply to it. They configure the BATCH provider
# (AzureWhisperSTTProvider), which is kept for resources where only a plain
# `whisper` deployment exists.
#
# api-version for wss://<host>/openai/realtime. Versioned independently of the
# REST routes above; the older value is rejected at the handshake.
# CORDIA_AUDIO_REALTIME_API_VERSION=2025-04-01-preview
#
# Transcription model. Named inside the session config, NOT as a `deployment`
# query parameter — the realtime route answers that with OperationNotSupported.
# CORDIA_AUDIO_REALTIME_MODEL=gpt-realtime-whisper
#
# Trailing silence the service's server-side VAD requires before it endpoints an
# utterance. This IS the endpointing latency, the realtime counterpart of
# CORDIA_AUDIO_VAD_HANGOVER_FRAMES: too short truncates mid-sentence pauses, too
# long delays every reply.
# CORDIA_AUDIO_REALTIME_SILENCE_DURATION_MS=500
#
# Maximum PCM per input_audio_buffer.append frame (16000 B = 500 ms at 16 kHz
# 16-bit mono). Caps one write, not a buffer: the sender awaits each frame, so
# the caller's audio stream is back-pressured rather than accumulated.
# CORDIA_AUDIO_REALTIME_SEND_CHUNK_BYTES=16000
#
# Voice preset requested from the speech route.
# CORDIA_AUDIO_TTS_VOICE=alloy
#
# Output container: pcm (default), wav, mp3, opus, aac, flac. Only pcm streams
# usefully chunk-by-chunk without a container header.
#
# NOTE: gpt-4o-mini-tts emits 24 kHz 16-bit mono PCM. PSTN carriage needs
# 8 kHz mulaw, and NOTHING in this repo resamples — correct downsampling needs
# an anti-aliasing filter, so it belongs to the media plane / the AudioSink
# implementation, not to the provider. The rate below is stamped onto each
# chunk's metadata so a sink knows what it received; it does not convert.
# CORDIA_AUDIO_TTS_RESPONSE_FORMAT=pcm
# CORDIA_AUDIO_TTS_SAMPLE_RATE_HZ=24000
#
# Bytes per streamed audio chunk. Smaller cuts time-to-first-chunk at the cost
# of more sink writes.
# CORDIA_AUDIO_TTS_CHUNK_BYTES=4096
#
# Inbound caller PCM, assumed 16-bit signed little-endian mono.
# CORDIA_AUDIO_INPUT_SAMPLE_RATE_HZ=16000
#
# Voice-activity detection — BATCH provider only (AzureWhisperSTTProvider); the
# realtime provider ignores every knob in this block. whisper is a BATCH
# recogniser, so with it this agent owns endpointing: VAD decides where each
# utterance starts and stops.
#   FRAME_MS         analysis frame size; rate * ms must be a multiple of 1000.
#   ENERGY_THRESHOLD RMS amplitude (int16 scale, 0..32767) counting as speech.
#   ONSET_FRAMES     consecutive speech frames needed to start (debounces clicks).
#   HANGOVER_FRAMES  consecutive silence frames needed to stop. This IS the
#                    endpointing latency (25 x 20 ms = 500 ms) and is the single
#                    most impactful knob: too short truncates mid-sentence
#                    pauses, too long delays every reply.
#   PREROLL_FRAMES   frames kept before onset so the first phoneme isn't clipped.
# CORDIA_AUDIO_VAD_FRAME_MS=20
# CORDIA_AUDIO_VAD_ENERGY_THRESHOLD=300.0
# CORDIA_AUDIO_VAD_ONSET_FRAMES=2
# CORDIA_AUDIO_VAD_HANGOVER_FRAMES=25
# CORDIA_AUDIO_VAD_PREROLL_FRAMES=5
#
# Hard cap on buffered speech; a caller who never pauses is force-endpointed
# rather than buffered without bound.
# CORDIA_AUDIO_MAX_UTTERANCE_SECONDS=30.0
#
# Confidence reported when a transcription response carries no per-segment
# log-probabilities to derive one from.
# CORDIA_AUDIO_FALLBACK_ASR_CONFIDENCE=0.9
#
# First-attempt deadline for either audio call (seconds); retries grow the
# budget, mirroring cordia_agent/llm/invoke.py.
# CORDIA_AUDIO_BASE_TIMEOUT_SECONDS=10.0
#
# Any of the above may be overridden per role with a _<ROLE> suffix, e.g.:
# CORDIA_AUDIO_TTS_RESPONSE_FORMAT_PSTN=wav

# === Booking API (REQUIRED for any tool call) ===
#
# Base URL of the .NET API. Unset ⇒ graph.py registers NO ToolClient and every
# data tool fails with "no ToolClient configured" at the first node that needs
# one (consent_gate). Set it and bootstrap_tool_client() wires the session
# client that resolve_tenant then installs the verified TenantContext onto.
CORDIA_API_BASE_URL=http://localhost:8000

# === TenantContext verification (spec-15, REQUIRED) ===
#
# JSON object mapping kid -> raw HMAC secret. Without it the agent registers no
# verifier and resolve_tenant fails closed on every run.
#
# The secret BYTES must match the apps/api signer, which stores them
# base64-encoded under Secrets:TenantContextSigningKeys:Keys:<kid> — i.e. for
# each kid: base64decode(apps/api value) == utf8(this value).
#
# The value below pairs with the DEV-ONLY key in appsettings.Development.json.
CORDIA_TENANT_CONTEXT_SIGNING_KEYS={"dev-2026-07":"DEV-ONLY-tenant-context-signing-key-not-a-real-secret"}

# === Observability (optional) ===
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# === Persistence ===
POSTGRES_URI=postgresql://cordia:localdev@localhost:5432/Cordia_Agent

# === LangGraph client (scripts) ===
LANGGRAPH_URL=http://localhost:2024
