{
  "//": "Maps generated C# enum type names -> PostgreSQL enum type + member string values. Used by tools/scripts/generate_csharp_types.mjs to inject [JsonStringEnumMemberName]/[PgName] attributes for EF Core. Empty by default in the Cordia base; add an entry per pg-enum-mapped enum, e.g.:",
  "//example": {
    "GreetingStatusEnum": {
      "pgEnumName": "greeting_status",
      "members": { "Pending": "pending", "Greeted": "greeted" }
    }
  },
  "enums": {
    "OperationTypeEnum": {
      "pgEnumName": "operation_type_enum",
      "members": {
        "Cancel": "cancel",
        "Create": "create",
        "Modify": "modify",
        "Reschedule": "reschedule"
      }
    },
    "VerificationActionEnum": {
      "pgEnumName": "verification_action_enum",
      "members": {
        "Cancel": "cancel",
        "Modify": "modify",
        "OwnerOverride": "owner_override",
        "ReadSensitive": "read_sensitive",
        "Refund": "refund",
        "UsePaymentMethod": "use_payment_method"
      }
    }
  }
}
