# EditorConfig helps maintain consistent coding styles across editors
# https://editorconfig.org

root = true

# Default settings for all files
[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

# Python files
[*.py]
indent_size = 4
max_line_length = 88

# Python stub files
[*.pyi]
indent_size = 4

# C# files
[*.cs]
indent_size = 4
charset = utf-8-bom

# C# project files
[*.csproj]
indent_size = 2

# Solution files
[*.sln]
indent_style = tab

# JSON files
[*.json]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Shell scripts
[*.sh]
indent_size = 2

# Makefiles
[Makefile]
indent_style = tab

# Docker files
[Dockerfile*]
indent_size = 4
