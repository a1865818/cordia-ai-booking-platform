        "text": {
          "description": "Final recognized transcript text.",
          "title": "Text",
          "type": "string"
        },
        "asr_confidence": {
          "description": "ASR confidence, 0..1.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Asr Confidence",
          "type": "number"
        },
        "is_endpoint": {
          "default": true,
          "description": "Whether this marks an utterance endpoint.",
          "title": "Is Endpoint",
          "type": "boolean"
        }
      },
      "required": [
        "tenant_id",
        "session_id",
        "turn_id",
        "correlation_id",
        "seq",
        "ts",
        "text",
        "asr_confidence"
      ],
      "title": "TranscriptFinalFrame",
      "type": "object"
    },
