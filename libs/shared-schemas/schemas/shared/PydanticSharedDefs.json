        "tenant_id",
        "session_id",
        "turn_id",
        "correlation_id",
        "seq",
        "ts",
        "tool_name",
        "phase",
        "elapsed_ms"
      ],
      "title": "ToolProgressFrame",
      "type": "object"
    },
