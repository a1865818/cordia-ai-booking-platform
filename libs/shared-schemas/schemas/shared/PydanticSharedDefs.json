{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pydantic Shared Definitions",
  "$defs": {
    "AvailabilityMode": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AvailabilityMode",
      "description": "Availability mode bounding agent wording (owned by spec 07).",
      "type": "string",
      "enum": [
        "informational",
        "live",
        "held",
        "confirmed"
      ]
    },
    "GreetingStatus": {
      "description": "Lifecycle status of a greeting.",
      "enum": [
        "pending",
        "greeted"
      ],
      "title": "GreetingStatus",
      "type": "string"
    },
    "HelloConfiguration": {
      "additionalProperties": false,
      "description": "Configurable parameters for the hello graph.",
      "properties": {
        "greeting": {
          "default": "Hello",
          "description": "Greeting prefix to use.",
          "title": "Greeting",
          "type": "string"
        }
      },
      "title": "HelloConfiguration",
      "type": "object"
    },
    "HelloInputState": {
      "additionalProperties": false,
      "description": "Input to the hello graph.",
      "properties": {
        "name": {
          "description": "Name of the person to greet.",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "HelloInputState",
      "type": "object"
    },
    "HelloMessageCode": {
      "description": "Discriminator for hello-graph stream messages.",
      "enum": [
        "started",
        "completed"
      ],
      "title": "HelloMessageCode",
      "type": "string"
    },
    "HelloOutputState": {
      "additionalProperties": false,
      "description": "Output of the hello graph.",
      "properties": {
        "message": {
          "description": "The rendered greeting message.",
          "title": "Message",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/GreetingStatus",
          "default": "greeted",
          "description": "Resulting greeting status."
        }
      },
      "required": [
        "message"
      ],
      "title": "HelloOutputState",
      "type": "object"
    },
    "HelloStreamMessage": {
      "additionalProperties": false,
      "description": "A single streamed message frame from the hello graph.",
      "properties": {
        "code": {
          "$ref": "#/$defs/HelloMessageCode",
          "description": "Message code discriminator."
        },
        "text": {
          "description": "Human-readable message text.",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "code",
        "text"
      ],
      "title": "HelloStreamMessage",
      "type": "object"
    },
    "ToolResultEnvelope": {
      "additionalProperties": false,
      "description": "Single closed wrapper returned by every tool (spec 03 \u00a74.2).",
      "properties": {
        "ok": {
          "description": "Machine-readable success/failure.",
          "title": "Ok",
          "type": "boolean"
        },
        "status": {
          "description": "Per-tool status code; never raw error text.",
          "title": "Status",
          "type": "string"
        },
        "customer_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Safe customer-facing string; never raw provider text.",
          "title": "Customer Hint"
        },
        "recoverable_fields": {
          "description": "Fields the agent may re-prompt to correct.",
          "items": {
            "type": "string"
          },
          "title": "Recoverable Fields",
          "type": "array"
        },
        "suggested_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Machine hint for next move, e.g. request_alternative_time.",
          "title": "Suggested Action"
        },
        "data": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tool-specific typed payload (per-tool Out schemas).",
          "title": "Data"
        },
        "correlation_id": {
          "description": "Propagated from the typed tool client; consumed by observability.",
          "title": "Correlation Id",
          "type": "string"
        },
        "schema_version": {
          "description": "Cross-language contract version.",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "ok",
        "status",
        "correlation_id",
        "schema_version"
      ],
      "title": "ToolResultEnvelope",
      "type": "object"
    }
  }
}
