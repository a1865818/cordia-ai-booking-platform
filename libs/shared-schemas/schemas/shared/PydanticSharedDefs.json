      "type": "string"
    },
    "HelloConfiguration": {
      "additionalProperties": false,
      "description": "Configurable parameters for the hello graph.",
      "properties": {
        "greeting": {
          "default": "Hello",
          "description": "Greeting prefix to use.",
          "title": "Greeting",
          "type": "string"
        }
      },
      "title": "HelloConfiguration",
      "type": "object"
    },
    "HelloInputState": {
      "additionalProperties": false,
      "description": "Input to the hello graph.",
      "properties": {
        "name": {
          "description": "Name of the person to greet.",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "HelloInputState",
      "type": "object"
    },
    "HelloOutputState": {
      "additionalProperties": false,
      "description": "Output of the hello graph.",
      "properties": {
        "message": {
          "description": "The rendered greeting message.",
          "title": "Message",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/GreetingStatus",
          "default": "greeted",
          "description": "Resulting greeting status."
        }
      },
      "required": [
        "message"
      ],
      "title": "HelloOutputState",
      "type": "object"
    },
    "StreamFrameType": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "StreamFrameType",
      "description": "Discriminator for streaming voice-pipeline frames (spec 01 \u00a75.1 / \u00a76.3).",
