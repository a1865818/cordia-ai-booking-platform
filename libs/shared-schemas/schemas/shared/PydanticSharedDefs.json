    "GreetingStatus": {
      "description": "Lifecycle status of a greeting.",
      "enum": [
        "pending",
        "greeted"
      ],
      "title": "GreetingStatus",
      "type": "string"
    },
    "HelloConfiguration": {
      "additionalProperties": false,
      "description": "Configurable parameters for the hello graph.",
      "properties": {
        "greeting": {
          "default": "Hello",
          "description": "Greeting prefix to use.",
          "title": "Greeting",
          "type": "string"
        }
      },
      "title": "HelloConfiguration",
      "type": "object"
    },
    "HelloInputState": {
      "additionalProperties": false,
      "description": "Input to the hello graph.",
      "properties": {
        "name": {
          "description": "Name of the person to greet.",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "HelloInputState",
      "type": "object"
    },
    "HelloOutputState": {
      "additionalProperties": false,
      "description": "Output of the hello graph.",
      "properties": {
        "message": {
          "description": "The rendered greeting message.",
          "title": "Message",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/GreetingStatus",
          "default": "greeted",
          "description": "Resulting greeting status."
        }
      },
      "required": [
        "message"
      ],
      "title": "HelloOutputState",
      "type": "object"
    },
    "StreamFrameType": {
      "description": "Discriminator for streaming voice-pipeline frames (spec 01 \u00a75.1 / \u00a76.3).",
      "enum": [
        "audio.started",
        "transcript.partial",
        "transcript.final",
        "agent.text.delta",
        "agent.text.final",
        "tool.progress",
        "tts.audio.delta",
        "barge_in.detected",
        "turn.cancelled"
      ],
      "title": "StreamFrameType",
      "type": "string"
    },
    "ToolProgressFrame": {
      "additionalProperties": false,
      "description": "Progress signal for an in-flight tool invocation.",
      "properties": {
        "type": {
          "$ref": "#/$defs/StreamFrameType",
          "default": "tool.progress",
          "description": "Frame type discriminator."
        },
        "tenant_id": {
          "description": "Opaque tenant scope, propagated not resolved (Inv-13).",
