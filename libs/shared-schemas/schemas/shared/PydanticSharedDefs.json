          "title": "Seq",
          "type": "integer"
        },
        "ts": {
          "description": "ISO-8601 timestamp with offset.",
          "title": "Ts",
          "type": "string"
        },
        "tool_name": {
          "description": "Name of the tool being invoked.",
          "title": "Tool Name",
          "type": "string"
        },
        "phase": {
          "description": "Progress phase, e.g. \"checking_availability\".",
          "title": "Phase",
          "type": "string"
        },
        "elapsed_ms": {
          "description": "Elapsed time since invocation, in milliseconds.",
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "tenant_id",
        "session_id",
        "turn_id",
        "correlation_id",
        "seq",
        "ts",
        "tool_name",
        "phase",
        "elapsed_ms"
