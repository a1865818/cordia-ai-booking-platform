          "title": "Cancelled Turn Id",
          "type": "string"
        },
        "material_content_delivered": {
          "description": "Whether material content was delivered before cancellation (Inv-16: false => interrupted speech is non-authoritative).",
          "title": "Material Content Delivered",
          "type": "boolean"
