      "enum": [
        "audio.started",
        "transcript.partial",
        "transcript.final",
        "agent.text.delta",
        "agent.text.final",
        "tool.progress",
        "tts.audio.delta",
        "barge_in.detected",
        "turn.cancelled"
      ]
    },
    "ToolProgressFrame": {
      "additionalProperties": false,
      "description": "Progress signal for an in-flight tool invocation.",
