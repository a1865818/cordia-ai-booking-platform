{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pydantic Shared Definitions",
  "$defs": {
    "AvailabilityMode": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AvailabilityMode",
      "description": "Availability mode bounding agent wording (owned by spec 07).",
      "type": "string",
      "enum": [
        "informational",
        "live",
        "held",
        "confirmed"
      ]
    },
    "CatalogItemStatus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CatalogItemStatus",
      "description": "Status codes shared by search_vendor_catalog and get_catalog_item (spec 03 \u00a74.3).",
      "type": "string",
      "enum": [
        "ok",
        "not_found",
        "catalog_unavailable"
      ]
    },
    "CheckCandidateAvailabilityStatus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CheckCandidateAvailabilityStatus",
      "description": "Status codes for check_candidate_availability (spec 03 \u00a74.3).",
      "type": "string",
      "enum": [
        "available",
        "available_pending",
        "unavailable",
        "held",
        "hold_failed"
      ]
    },
    "CheckVerificationStatus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CheckVerificationStatus",
      "description": "Status codes for check_verification (spec 03 \u00a74.3).",
      "type": "string",
      "enum": [
        "granted",
        "pending",
        "failed",
        "expired"
      ]
    },
    "FindCustomerContextStatus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FindCustomerContextStatus",
      "description": "Status codes for find_customer_context (spec 03 \u00a74.3).",
      "type": "string",
      "enum": [
        "found",
        "multiple",
        "none"
      ]
    },
    "FindManageableBookingsStatus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FindManageableBookingsStatus",
      "description": "Status codes for find_manageable_bookings (spec 03 \u00a74.4).",
      "type": "string",
      "enum": [
        "found",
        "multiple",
        "none"
      ]
    },
    "GetBookingDetailsStatus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "GetBookingDetailsStatus",
      "description": "Status codes for get_booking_details (spec 03 \u00a74.4).",
      "type": "string",
      "enum": [
        "ok",
        "requires_verification",
        "not_found"
      ]
    },
    "GetTenantContextStatus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "GetTenantContextStatus",
      "description": "Status codes for get_tenant_context (spec 03 \u00a74.3).",
      "type": "string",
      "enum": [
        "resolved",
        "tenant_not_resolved"
      ]
    },
    "GreetingStatus": {
      "description": "Lifecycle status of a greeting.",
      "enum": [
        "pending",
        "greeted"
      ],
      "title": "GreetingStatus",
      "type": "string"
    },
    "HelloConfiguration": {
      "additionalProperties": false,
      "description": "Configurable parameters for the hello graph.",
      "properties": {
        "greeting": {
          "default": "Hello",
          "description": "Greeting prefix to use.",
          "title": "Greeting",
          "type": "string"
        }
      },
      "title": "HelloConfiguration",
      "type": "object"
    },
    "HelloInputState": {
      "additionalProperties": false,
      "description": "Input to the hello graph.",
      "properties": {
        "name": {
          "description": "Name of the person to greet.",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "HelloInputState",
      "type": "object"
    },
    "HelloMessageCode": {
      "description": "Discriminator for hello-graph stream messages.",
      "enum": [
        "started",
        "completed"
      ],
      "title": "HelloMessageCode",
      "type": "string"
    },
    "HelloOutputState": {
      "additionalProperties": false,
      "description": "Output of the hello graph.",
      "properties": {
        "message": {
          "description": "The rendered greeting message.",
          "title": "Message",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/GreetingStatus",
          "default": "greeted",
          "description": "Resulting greeting status."
        }
      },
      "required": [
        "message"
      ],
      "title": "HelloOutputState",
      "type": "object"
    },
    "HelloStreamMessage": {
      "additionalProperties": false,
      "description": "A single streamed message frame from the hello graph.",
      "properties": {
        "code": {
          "$ref": "#/$defs/HelloMessageCode",
          "description": "Message code discriminator."
        },
        "text": {
          "description": "Human-readable message text.",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "code",
        "text"
      ],
      "title": "HelloStreamMessage",
      "type": "object"
    },
    "RequestHumanHandoffStatus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "RequestHumanHandoffStatus",
      "description": "Status codes for request_human_handoff (spec 03 \u00a74.3).",
      "type": "string",
      "enum": [
        "created",
        "existing",
        "routing_unavailable"
      ]
    },
    "RequestVerificationStatus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "RequestVerificationStatus",
      "description": "Status codes for request_verification (spec 03 \u00a74.3).",
      "type": "string",
      "enum": [
        "sent",
        "already_sent",
        "rate_limited",
        "no_verified_destination"
      ]
    },
    "SubmitBookingCancellationStatus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SubmitBookingCancellationStatus",
      "description": "Status codes for submit_booking_cancellation (spec 03 \u00a74.4).",
      "type": "string",
      "enum": [
        "accepted",
        "already_cancelled",
        "duplicate_accepted",
        "idempotency_conflict",
        "stale_version",
        "verification_required"
      ]
    },
    "SubmitBookingModificationStatus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SubmitBookingModificationStatus",
      "description": "Status codes for submit_booking_modification (spec 03 \u00a74.4).",
      "type": "string",
      "enum": [
        "accepted",
        "duplicate_accepted",
        "idempotency_conflict",
        "stale_version",
        "verification_required",
        "confirmation_invalid"
      ]
    },
    "SubmitConfirmedIntentStatus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SubmitConfirmedIntentStatus",
      "description": "Status codes for submit_confirmed_intent (spec 03 \u00a74.3).",
      "type": "string",
      "enum": [
        "accepted",
        "duplicate_accepted",
        "idempotency_conflict",
        "confirmation_invalid",
        "policy_failed",
        "validation_failed"
      ]
    },
    "ToolResultEnvelope": {
      "additionalProperties": false,
      "description": "Single closed wrapper returned by every tool (spec 03 \u00a74.2).",
      "properties": {
        "ok": {
          "description": "Machine-readable success/failure.",
          "title": "Ok",
          "type": "boolean"
        },
        "status": {
          "description": "Per-tool status code; never raw error text.",
          "title": "Status",
          "type": "string"
        },
        "customer_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Safe customer-facing string; never raw provider text.",
          "title": "Customer Hint"
        },
        "recoverable_fields": {
          "description": "Fields the agent may re-prompt to correct.",
          "items": {
            "type": "string"
          },
          "title": "Recoverable Fields",
          "type": "array"
        },
        "suggested_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Machine hint for next move, e.g. request_alternative_time.",
          "title": "Suggested Action"
        },
        "data": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tool-specific typed payload (per-tool Out schemas).",
          "title": "Data"
        },
        "correlation_id": {
          "description": "Propagated from the typed tool client; consumed by observability.",
          "title": "Correlation Id",
          "type": "string"
        },
        "schema_version": {
          "description": "Cross-language contract version.",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "ok",
        "status",
        "correlation_id",
        "schema_version"
      ],
      "title": "ToolResultEnvelope",
      "type": "object"
    },
    "ValidateBookingChangeStatus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ValidateBookingChangeStatus",
      "description": "Status codes for validate_booking_change (spec 03 \u00a74.4).",
      "type": "string",
      "enum": [
        "valid",
        "policy_failed",
        "stale_version",
        "capacity_unavailable"
      ]
    },
    "ValidateBookingDraftStatus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ValidateBookingDraftStatus",
      "description": "Status codes for validate_booking_draft (spec 03 \u00a74.3).",
      "type": "string",
      "enum": [
        "valid",
        "minimum_notice_not_met",
        "outside_operating_hours",
        "party_size_unsupported",
        "service_ineligible",
        "field_missing",
        "field_ambiguous"
      ]
    }
  }
}
