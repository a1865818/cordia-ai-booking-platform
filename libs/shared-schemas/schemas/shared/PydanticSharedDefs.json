{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pydantic Shared Definitions",
  "$defs": {
    "AgentTextDeltaFrame": {
      "additionalProperties": false,
      "description": "Incremental agent response text chunk.",
      "properties": {
        "type": {
          "const": "agent.text.delta",
          "description": "Frame type discriminator.",
          "title": "Type",
          "type": "string"
        },
        "tenant_id": {
          "description": "Opaque tenant scope, propagated not resolved (Inv-13).",
          "title": "Tenant Id",
          "type": "string"
        },
        "session_id": {
          "description": "Identifies one call/conversation.",
          "title": "Session Id",
          "type": "string"
        },
        "turn_id": {
          "description": "Identifies one customer/agent contribution.",
          "title": "Turn Id",
          "type": "string"
        },
        "correlation_id": {
          "description": "Correlation id, begins at channel ingress (\u00a725.1).",
          "title": "Correlation Id",
          "type": "string"
        },
        "causation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Event-lineage parent id.",
          "title": "Causation Id"
        },
        "seq": {
          "description": "Monotonic per-session ordering counter.",
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "ts": {
          "description": "ISO-8601 timestamp with offset.",
          "title": "Ts",
          "type": "string"
        },
        "delta": {
          "description": "Incremental agent response text chunk.",
          "title": "Delta",
          "type": "string"
        }
      },
      "required": [
        "type",
        "tenant_id",
        "session_id",
        "turn_id",
        "correlation_id",
        "seq",
        "ts",
        "delta"
      ],
      "title": "AgentTextDeltaFrame",
      "type": "object"
    },
