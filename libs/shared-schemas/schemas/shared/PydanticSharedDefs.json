{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pydantic Shared Definitions",
  "$defs": {
    "AgentTextDeltaFrame": {
      "additionalProperties": false,
      "description": "Incremental agent response text chunk.",
      "properties": {
        "type": {
          "const": "agent.text.delta",
          "description": "Frame type discriminator.",
          "title": "Type",
          "type": "string"
        },
        "tenant_id": {
          "description": "Opaque tenant scope, propagated not resolved (Inv-13).",
          "title": "Tenant Id",
          "type": "string"
        },
        "session_id": {
          "description": "Identifies one call/conversation.",
          "title": "Session Id",
          "type": "string"
        },
        "turn_id": {
          "description": "Identifies one customer/agent contribution.",
          "title": "Turn Id",
          "type": "string"
        },
        "correlation_id": {
          "description": "Correlation id, begins at channel ingress (\u00a725.1).",
          "title": "Correlation Id",
          "type": "string"
        },
        "causation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Event-lineage parent id.",
          "title": "Causation Id"
        },
        "seq": {
          "description": "Monotonic per-session ordering counter.",
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "ts": {
          "description": "ISO-8601 timestamp with offset.",
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "delta": {
          "description": "Incremental agent response text chunk.",
          "title": "Delta",
          "type": "string"
        }
      },
      "required": [
        "type",
        "tenant_id",
        "session_id",
        "turn_id",
        "correlation_id",
        "seq",
        "ts",
        "delta"
      ],
      "title": "AgentTextDeltaFrame",
      "type": "object"
    },
    "AgentTextFinalFrame": {
      "additionalProperties": false,
      "description": "Final, complete agent response text.",
      "properties": {
        "type": {
          "const": "agent.text.final",
          "description": "Frame type discriminator.",
          "title": "Type",
          "type": "string"
        },
        "tenant_id": {
          "description": "Opaque tenant scope, propagated not resolved (Inv-13).",
          "title": "Tenant Id",
          "type": "string"
        },
        "session_id": {
          "description": "Identifies one call/conversation.",
          "title": "Session Id",
          "type": "string"
        },
        "turn_id": {
          "description": "Identifies one customer/agent contribution.",
          "title": "Turn Id",
          "type": "string"
        },
        "correlation_id": {
          "description": "Correlation id, begins at channel ingress (\u00a725.1).",
          "title": "Correlation Id",
          "type": "string"
        },
        "causation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Event-lineage parent id.",
          "title": "Causation Id"
        },
        "seq": {
          "description": "Monotonic per-session ordering counter.",
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "ts": {
          "description": "ISO-8601 timestamp with offset.",
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "text": {
          "description": "Final, complete agent response text.",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "type",
        "tenant_id",
        "session_id",
        "turn_id",
        "correlation_id",
        "seq",
        "ts",
        "text"
      ],
      "title": "AgentTextFinalFrame",
      "type": "object"
    },
    "AudioStartedFrame": {
      "additionalProperties": false,
      "description": "Audio capture started; no payload beyond the envelope.",
      "properties": {
        "type": {
          "const": "audio.started",
          "description": "Frame type discriminator.",
          "title": "Type",
          "type": "string"
        },
        "tenant_id": {
          "description": "Opaque tenant scope, propagated not resolved (Inv-13).",
          "title": "Tenant Id",
          "type": "string"
        },
        "session_id": {
          "description": "Identifies one call/conversation.",
          "title": "Session Id",
          "type": "string"
        },
        "turn_id": {
          "description": "Identifies one customer/agent contribution.",
          "title": "Turn Id",
          "type": "string"
        },
        "correlation_id": {
          "description": "Correlation id, begins at channel ingress (\u00a725.1).",
          "title": "Correlation Id",
          "type": "string"
        },
        "causation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Event-lineage parent id.",
          "title": "Causation Id"
        },
        "seq": {
          "description": "Monotonic per-session ordering counter.",
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "ts": {
          "description": "ISO-8601 timestamp with offset.",
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "type",
        "tenant_id",
        "session_id",
        "turn_id",
        "correlation_id",
        "seq",
        "ts"
      ],
      "title": "AudioStartedFrame",
      "type": "object"
    },
    "AvailabilityMode": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AvailabilityMode",
      "description": "Availability mode bounding agent wording (owned by spec 07).",
      "type": "string",
      "enum": [
        "informational",
        "live",
        "held",
        "confirmed"
      ]
    },
    "BargeInFrame": {
      "additionalProperties": false,
      "description": "Caller barge-in detected; no payload beyond the envelope.",
      "properties": {
        "type": {
          "const": "barge_in.detected",
          "description": "Frame type discriminator.",
          "title": "Type",
          "type": "string"
        },
        "tenant_id": {
          "description": "Opaque tenant scope, propagated not resolved (Inv-13).",
          "title": "Tenant Id",
          "type": "string"
        },
        "session_id": {
          "description": "Identifies one call/conversation.",
          "title": "Session Id",
          "type": "string"
        },
        "turn_id": {
          "description": "Identifies one customer/agent contribution.",
          "title": "Turn Id",
          "type": "string"
        },
        "correlation_id": {
          "description": "Correlation id, begins at channel ingress (\u00a725.1).",
          "title": "Correlation Id",
          "type": "string"
        },
        "causation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Event-lineage parent id.",
          "title": "Causation Id"
        },
        "seq": {
          "description": "Monotonic per-session ordering counter.",
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "ts": {
          "description": "ISO-8601 timestamp with offset.",
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "type",
        "tenant_id",
        "session_id",
        "turn_id",
        "correlation_id",
        "seq",
        "ts"
      ],
      "title": "BargeInFrame",
      "type": "object"
    },
    "BookingDraft": {
      "additionalProperties": false,
      "description": "In-dialog typed booking draft; source of the canonical submitted payload.",
      "properties": {
        "tenant_id": {
          "description": "Tenant scope (Inv-13).",
          "title": "Tenant Id",
          "type": "string"
        },
        "session_id": {
          "description": "Dialog session ID.",
          "title": "Session Id",
          "type": "string"
        },
        "schema_version": {
          "description": "Draft schema version carried into the intent.",
          "title": "Schema Version",
          "type": "string"
        },
        "tenant_policy_version": {
          "description": "Tenant configuration/policy version.",
          "title": "Tenant Policy Version",
          "type": "string"
        },
        "customer": {
          "anyOf": [
            {
              "$ref": "#/$defs/CustomerRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Customer reference, if known."
        },
        "request": {
          "$ref": "#/$defs/BookingRequest",
          "description": "The booking request."
        },
        "source": {
          "$ref": "#/$defs/SourceInfo",
          "description": "Origin channel + language."
        },
        "field_provenance": {
          "additionalProperties": {
            "$ref": "#/$defs/FieldProvenance"
          },
          "description": "Internal capture metadata keyed by field; stripped on submit.",
          "title": "Field Provenance",
          "type": "object"
        }
      },
      "required": [
        "tenant_id",
        "session_id",
        "schema_version",
        "tenant_policy_version",
        "request",
        "source"
      ],
      "title": "BookingDraft",
      "type": "object"
    },
    "BookingRequest": {
      "additionalProperties": false,
      "description": "A single booking request captured during a dialog.",
      "properties": {
        "operation": {
          "$ref": "#/$defs/OperationType",
          "description": "Booking operation requested."
        },
        "service_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/TriState"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stable service ID, a TriState, or absent.",
          "title": "Service Id"
        },
        "location_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/TriState"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stable location ID, a TriState, or absent.",
          "title": "Location Id"
        },
        "starts_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "$ref": "#/$defs/TriState"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Offset-aware start, a TriState, or absent.",
          "title": "Starts At"
        },
        "party_size": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "$ref": "#/$defs/TriState"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Party size, a TriState, or absent.",
          "title": "Party Size"
        },
        "duration_minutes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "$ref": "#/$defs/TriState"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Duration minutes, a TriState, or absent.",
          "title": "Duration Minutes"
        },
        "special_requests": {
          "description": "Free-form special requests.",
          "items": {
            "type": "string"
          },
          "title": "Special Requests",
          "type": "array"
        },
        "target_booking_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Target booking; required for modify/cancel/reschedule.",
          "title": "Target Booking Id"
        },
        "target_booking_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optimistic-concurrency version of the target.",
          "title": "Target Booking Version"
        }
      },
      "required": [
        "operation"
      ],
      "title": "BookingRequest",
      "type": "object"
    },
    "CanonicalBookingDraft": {
      "additionalProperties": false,
      "description": "Submitted payload: BookingDraft minus field_provenance (DQ2=B).",
      "properties": {
        "tenant_id": {
          "description": "Tenant scope (Inv-13).",
          "title": "Tenant Id",
          "type": "string"
        },
        "session_id": {
          "description": "Dialog session ID.",
          "title": "Session Id",
          "type": "string"
        },
        "schema_version": {
          "description": "Draft schema version carried into the intent.",
          "title": "Schema Version",
          "type": "string"
        },
        "tenant_policy_version": {
          "description": "Tenant configuration/policy version.",
          "title": "Tenant Policy Version",
          "type": "string"
        },
        "customer": {
          "anyOf": [
            {
              "$ref": "#/$defs/CustomerRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Customer reference, if known."
        },
        "request": {
          "$ref": "#/$defs/BookingRequest",
          "description": "The booking request."
        },
        "source": {
          "$ref": "#/$defs/SourceInfo",
          "description": "Origin channel + language."
        }
      },
      "required": [
        "tenant_id",
        "session_id",
        "schema_version",
        "tenant_policy_version",
        "request",
        "source"
      ],
      "title": "CanonicalBookingDraft",
      "type": "object"
    },
    "CaptureMethod": {
      "description": "How a field value was captured during the dialog.",
      "enum": [
        "speech",
        "dtmf",
        "tool_selection",
        "channel_verified"
      ],
      "title": "CaptureMethod",
      "type": "string"
    },
    "CatalogItemStatus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CatalogItemStatus",
      "description": "Status codes shared by search_vendor_catalog and get_catalog_item (spec 03 \u00a74.3).",
      "type": "string",
      "enum": [
        "ok",
        "not_found",
        "catalog_unavailable"
      ]
    },
    "Channel": {
      "description": "Origin channel a draft was captured on.",
      "enum": [
        "voice",
        "sms",
        "web",
        "email"
      ],
      "title": "Channel",
      "type": "string"
    },
    "CheckCandidateAvailabilityStatus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CheckCandidateAvailabilityStatus",
      "description": "Status codes for check_candidate_availability (spec 03 \u00a74.3).",
      "type": "string",
      "enum": [
        "available",
        "available_pending",
        "unavailable",
        "held",
        "hold_failed"
      ]
    },
    "CheckVerificationStatus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CheckVerificationStatus",
      "description": "Status codes for check_verification (spec 03 \u00a74.3).",
      "type": "string",
      "enum": [
        "granted",
        "pending",
        "failed",
        "expired"
      ]
    },
    "CustomerRef": {
      "additionalProperties": false,
      "description": "Reference to the customer; all optional (anonymous sessions).",
      "properties": {
        "customer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stable customer ID where known.",
          "title": "Customer Id"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Customer display name.",
          "title": "Display Name"
        },
        "phone_e164": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "E.164 phone; plain str (no pattern).",
          "title": "Phone E164"
        }
      },
      "title": "CustomerRef",
      "type": "object"
    },
    "DtmfCaptureMethod": {
      "const": "dtmf",
      "type": "string"
    },
    "DtmfFieldKind": {
      "enum": [
        "verification_code",
        "numeric"
      ],
      "type": "string"
    },
    "FieldProvenance": {
      "additionalProperties": false,
      "description": "Internal-only capture metadata for one field. Stripped on submit.",
      "properties": {
        "source_turn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Turn/message ID the value came from.",
          "title": "Source Turn Id"
        },
        "stt_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "STT/ASR confidence (internal-only).",
          "title": "Stt Confidence"
        },
        "model_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Model confidence (internal-only).",
          "title": "Model Confidence"
        },
        "capture_method": {
          "$ref": "#/$defs/CaptureMethod",
          "description": "How the value was captured."
        },
        "normalized_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Normalized form of the captured value.",
          "title": "Normalized Value"
        },
        "validation": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldValidation"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Validation outcome for the field."
        }
      },
      "required": [
        "capture_method"
      ],
      "title": "FieldProvenance",
      "type": "object"
    },
    "FieldValidation": {
      "description": "Validation outcome for a captured field.",
      "enum": [
        "valid",
        "invalid",
        "needs_clarification"
      ],
      "title": "FieldValidation",
      "type": "string"
    },
    "FindCustomerContextStatus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FindCustomerContextStatus",
      "description": "Status codes for find_customer_context (spec 03 \u00a74.3).",
      "type": "string",
      "enum": [
        "found",
        "multiple",
        "none"
      ]
    },
    "FindManageableBookingsStatus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FindManageableBookingsStatus",
      "description": "Status codes for find_manageable_bookings (spec 03 \u00a74.4).",
      "type": "string",
      "enum": [
        "found",
        "multiple",
        "none"
      ]
    },
    "GetBookingDetailsStatus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "GetBookingDetailsStatus",
      "description": "Status codes for get_booking_details (spec 03 \u00a74.4).",
      "type": "string",
      "enum": [
        "ok",
        "requires_verification",
        "not_found"
      ]
    },
    "GetTenantContextStatus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "GetTenantContextStatus",
      "description": "Status codes for get_tenant_context (spec 03 \u00a74.3).",
      "type": "string",
      "enum": [
        "resolved",
        "tenant_not_resolved"
      ]
    },
    "GreetingStatus": {
      "description": "Lifecycle status of a greeting.",
      "enum": [
        "pending",
        "greeted"
      ],
      "title": "GreetingStatus",
      "type": "string"
    },
    "HelloConfiguration": {
      "additionalProperties": false,
      "description": "Configurable parameters for the hello graph.",
      "properties": {
        "greeting": {
          "default": "Hello",
          "description": "Greeting prefix to use.",
          "title": "Greeting",
          "type": "string"
        }
      },
      "title": "HelloConfiguration",
      "type": "object"
    },
    "HelloInputState": {
      "additionalProperties": false,
      "description": "Input to the hello graph.",
      "properties": {
        "name": {
          "description": "Name of the person to greet.",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "HelloInputState",
      "type": "object"
    },
    "HelloOutputState": {
      "additionalProperties": false,
      "description": "Output of the hello graph.",
      "properties": {
        "message": {
          "description": "The rendered greeting message.",
          "title": "Message",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/GreetingStatus",
          "default": "greeted",
          "description": "Resulting greeting status."
        }
      },
      "required": [
        "message"
      ],
      "title": "HelloOutputState",
      "type": "object"
    },
    "MaskedDtmfSignal": {
      "additionalProperties": false,
      "description": "Structured masked DTMF signal \u2014 never carries cleartext digits.",
      "properties": {
        "tenant_id": {
          "description": "Opaque tenant scope, propagated not resolved.",
          "title": "Tenant Id",
          "type": "string"
        },
        "session_id": {
          "description": "Identifies one call/conversation.",
          "title": "Session Id",
          "type": "string"
        },
        "turn_id": {
          "description": "Identifies one customer/agent contribution.",
          "title": "Turn Id",
          "type": "string"
        },
        "correlation_id": {
          "description": "Correlation id, begins at channel ingress.",
          "title": "Correlation Id",
          "type": "string"
        },
        "causation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Event-lineage parent id.",
          "title": "Causation Id"
        },
        "field_id": {
          "description": "Target field identifier, e.g. verification_code or party_size.",
          "title": "Field Id",
          "type": "string"
        },
        "field_kind": {
          "$ref": "#/$defs/DtmfFieldKind",
          "description": "Semantic kind of the captured field."
        },
        "capture_method": {
          "$ref": "#/$defs/DtmfCaptureMethod",
          "description": "How the field value was captured."
        },
        "masked_value": {
          "description": "Display-safe masked representation of captured digits.",
          "title": "Masked Value",
          "type": "string"
        },
        "digit_count": {
          "description": "Number of digits captured, without exposing values.",
          "minimum": 1,
          "title": "Digit Count",
          "type": "integer"
        }
      },
      "required": [
        "tenant_id",
        "session_id",
        "turn_id",
        "correlation_id",
        "field_id",
        "field_kind",
        "capture_method",
        "masked_value",
        "digit_count"
      ],
      "title": "MaskedDtmfSignal",
      "type": "object"
    },
    "NormalizedOperationStatus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "NormalizedOperationStatus",
      "description": "Customer/agent-facing operation status from get_operation_status (spec 06).",
      "type": "string",
      "enum": [
        "accepted",
        "in_progress",
