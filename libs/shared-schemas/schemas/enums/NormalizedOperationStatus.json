{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NormalizedOperationStatus",
  "description": "Customer/agent-facing operation status from get_operation_status (spec 06).",
  "type": "string",
  "enum": [
    "accepted",
    "in_progress",
    "awaiting_user_action",
    "alternatives_required",
    "booked",
    "waitlisted",
    "rejected",
    "expired",
    "failed"
  ]
}
